[Unit]
Description=Market Bridge server stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/docker compose --env-file @INSTALL_DIR@/.env -f @INSTALL_DIR@/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file @INSTALL_DIR@/.env -f @INSTALL_DIR@/compose.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
