MARKET_BRIDGE_VERSION=latest
MARKET_BRIDGE_SERVER_IMAGE=docker.io/otsgame/market-bridge-server
MARKET_BRIDGE_PULL_POLICY=always

GO_SERVER_PROVIDER=mock
# disabled, longbridge, fmp, massive, or mock
GO_SERVER_INDEX_PROVIDER=disabled
# Keep this stable across restarts; increment it only when provider data semantics change.
GO_SERVER_DATA_VERSION=mock-v1
GO_SERVER_DATASET_TTL=24h
GO_SERVER_DATASET_WORKERS=2
GO_SERVER_DATASET_QUEUE_SIZE=100
GO_SERVER_DATASET_BUILD_TIMEOUT=10m
GO_SERVER_EMPTY_COVERAGE_TTL=15m
GO_SERVER_SECURITY_PROFILE_TTL=24h
GO_SERVER_SECURITY_PROFILE_MAX_STALE=720h
GO_SERVER_SECURITY_PROFILE_WORKERS=16
GO_SERVER_TOKEN=replace-with-a-long-random-token
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_PLAN_NAME=stocks_basic
MASSIVE_REQUESTS_PER_MINUTE=5
MASSIVE_REQUESTS_PER_MONTH=0
GO_SERVER_OPTIONS_PROVIDER=disabled
MASSIVE_OPTIONS_PLAN_NAME=options_basic
MASSIVE_OPTIONS_REQUESTS_PER_MINUTE=5
MASSIVE_OPTIONS_REQUESTS_PER_MONTH=0
MASSIVE_HISTORY_MAX_YEARS=5
GO_SERVER_A_SHARE_PROVIDER=disabled
GO_SERVER_HK_PROVIDER=disabled
TUSHARE_TOKEN=
TUSHARE_BASE_URL=https://api.tushare.pro
TUSHARE_REQUESTS_PER_MINUTE=200
TUSHARE_HISTORY_MAX_YEARS=5
GO_SERVER_NEWS_PROVIDER=disabled
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com
FMP_NEWS_POLL_INTERVAL=60s
FMP_HISTORY_MAX_YEARS=5
GO_SERVER_NEWS_RETENTION=720h
GO_SERVER_LIVE_PROVIDER=mock
GO_SERVER_LIVE_PROVIDERS=
GO_SERVER_LONGBRIDGE_HISTORY_ENABLED=false
GO_SERVER_LONGBRIDGE_DEPTH_ENABLED=false
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_HISTORY_MAX_YEARS=5
GO_SERVER_BINANCE_ENABLED=false
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_HISTORY_MAX_YEARS=5
MOCK_HISTORY_MAX_YEARS=5
GO_SERVER_CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=market
CLICKHOUSE_USER=market
CLICKHOUSE_PASSWORD=
GO_SERVER_CLICKHOUSE_RETENTION=43800h
GO_SERVER_CLICKHOUSE_CLEANUP_INTERVAL=720h
GO_SERVER_REDIS_ENABLED=false
# For Redis on the Docker host, use host.docker.internal:6379.
GO_SERVER_REDIS_ADDRESS=
GO_SERVER_REDIS_USERNAME=
GO_SERVER_REDIS_PASSWORD=
GO_SERVER_REDIS_DB=0
GO_SERVER_REDIS_TTL=24h
GO_SERVER_MARKET_HISTORY_SYNC_ENABLED=false
GO_SERVER_MARKET_HISTORY_SYNC_INTERVAL=24h
