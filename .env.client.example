MARKET_BRIDGE_VERSION=latest
MARKET_BRIDGE_CLIENT_IMAGE=docker.io/otsgame/market-bridge-client
MARKET_BRIDGE_PULL_POLICY=always
COMPOSE_PROFILES=local-redis,clickhouse

GO_CLIENT_SERVER_URL=https://market.example.com
# Use the member's personal API key. GO_SERVER_TOKEN is only for legacy/admin access.
GO_CLIENT_SERVER_TOKEN=replace-with-a-personal-api-key
GO_CLIENT_PARQUET_TTL=720h
GO_CLIENT_CLEANUP_INTERVAL=6h
GO_CLIENT_REDIS_ENABLED=true
GO_CLIENT_REDIS_ADDRESS=127.0.0.1:6379
GO_CLIENT_REDIS_USERNAME=
GO_CLIENT_REDIS_PASSWORD=replace-with-the-redis-password
GO_CLIENT_REDIS_DB=0
GO_CLIENT_REDIS_TTL=24h
# When go-server advertises Redis, local Redis is logically disabled. To avoid
# starting the local container too, remove local-redis from COMPOSE_PROFILES.
GO_CLIENT_EMPTY_COVERAGE_TTL=15m
GO_CLIENT_NEWS_RETENTION=720h
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_MAXMEMORY=1gb

GO_CLIENT_CLICKHOUSE_ENABLED=true
# To fully disable local ClickHouse, set this false and remove clickhouse from COMPOSE_PROFILES.
# Default: persist completed bars only. Set false to also persist snapshots/trades/depth.
GO_CLIENT_CLICKHOUSE_COMPLETED_BARS_ONLY=true
GO_CLIENT_CLICKHOUSE_RETENTION=43800h
GO_CLIENT_CLICKHOUSE_CLEANUP_INTERVAL=720h
GO_CLIENT_STORAGE_CAPABILITY_INTERVAL=5m
GO_CLIENT_MARKET_HISTORY_SYNC_ENABLED=false
GO_CLIENT_MARKET_HISTORY_SYNC_INTERVAL=24h
GO_CLIENT_CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_VERSION=25.8-alpine
CLICKHOUSE_DATABASE=market
CLICKHOUSE_USER=market
CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_MEMORY_LIMIT=2g
CLICKHOUSE_CPUS=2
