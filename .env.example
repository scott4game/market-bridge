# Release images
MARKET_BRIDGE_VERSION=latest
MARKET_BRIDGE_SERVER_IMAGE=ghcr.io/scott4game/market-bridge-server
MARKET_BRIDGE_CLIENT_IMAGE=ghcr.io/scott4game/market-bridge-client
MARKET_BRIDGE_PULL_POLICY=always

# Optional when GHCR packages are private
GHCR_USERNAME=
GHCR_TOKEN=

# go-server
# 普通美股和 F: 期货历史源：massive（真实行情，需 MASSIVE_API_KEY）或 mock（模拟）。
# 此项不控制 I: 指数；不要填 longbridge。
GO_SERVER_PROVIDER=mock

# I: 指数历史默认来源（独立于普通美股历史和实时订阅）：
# disabled 关闭（默认）；longbridge 长桥；massive Massive；fmp FMP；mock 模拟。
# longbridge：需 LONGBRIDGE_APP_KEY / LONGBRIDGE_APP_SECRET / LONGBRIDGE_ACCESS_TOKEN。
# CLI 的 longbridge auth login 不会自动为 go-server 提供凭据。
# 支持 I:NDX（纳斯达克100）、I:SPX（标普500）、I:VIX、I:IXIC（纳斯达克综合）、
# I:DJI、I:HSI、I:HSCEI、I:HSTECH。
# massive：需 MASSIVE_API_KEY 和对应 Indices 权限；股票权限不等于指数权限。
# fmp：需 FMP_API_KEY；支持 I:VIX/I:NDX/I:SPX/I:IXIC/I:DJI/I:HSI。
GO_SERVER_INDEX_PROVIDER=disabled

# 按指数覆盖默认来源，格式 I:代码=来源，多项用逗号分隔。
# 优先级：精确路由 > GO_SERVER_INDEX_PROVIDER；留空表示全部使用默认来源。
# 来源同样支持 disabled/longbridge/massive/fmp/mock；disabled 可单独关闭某指数。
# 每个使用的来源都需配置凭据；权限不足或请求失败不会自动切换来源。
GO_SERVER_INDEX_ROUTES=
# 示例1：所有已支持指数走长桥
# GO_SERVER_INDEX_PROVIDER=longbridge
# GO_SERVER_INDEX_ROUTES=
# 示例2：所有指数走 Massive（实际可用范围取决于上游权限）
# GO_SERVER_INDEX_PROVIDER=massive
# GO_SERVER_INDEX_ROUTES=
# 示例3：默认长桥，标普500单独走 Massive，VIX 单独走 FMP
# GO_SERVER_INDEX_PROVIDER=longbridge
# GO_SERVER_INDEX_ROUTES=I:SPX=massive,I:VIX=fmp
# 示例4：仅开启指定指数，其余关闭
# GO_SERVER_INDEX_PROVIDER=disabled
# GO_SERVER_INDEX_ROUTES=I:NDX=longbridge,I:SPX=longbridge,I:VIX=longbridge
# 使用示例时替换上面的有效定义，不要重复定义同名变量。
# compose.yaml 必须传入 GO_SERVER_INDEX_PROVIDER 和 GO_SERVER_INDEX_ROUTES。
# 修改后需重新创建 go-server 容器（docker compose up -d --force-recreate go-server）。
# Keep this stable across restarts; increment it only when provider data semantics change.
GO_SERVER_DATA_VERSION=mock-v1
GO_SERVER_DATASET_TTL=24h
GO_SERVER_DATASET_WORKERS=2
GO_SERVER_DATASET_QUEUE_SIZE=100
GO_SERVER_DATASET_BUILD_TIMEOUT=10m
GO_SERVER_EMPTY_COVERAGE_TTL=15m
GO_SERVER_SECURITY_PROFILE_TTL=24h
GO_SERVER_SECURITY_PROFILE_MAX_STALE=720h
GO_SERVER_SECURITY_PROFILE_WORKERS=16
GO_SERVER_TOKEN=replace-with-a-long-random-token
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_PLAN_NAME=stocks_basic
MASSIVE_REQUESTS_PER_MINUTE=5
MASSIVE_REQUESTS_PER_MONTH=0
# Options Developer: set provider=massive, plan=options_developer, requests_per_minute=0.
# Developer includes 4 years of history and 15-minute delayed market data.
GO_SERVER_OPTIONS_PROVIDER=disabled
# Dedicated options key; independent of MASSIVE_API_KEY.
MASSIVE_OPTIONS_API_KEY=
MASSIVE_OPTIONS_PLAN_NAME=options_basic
MASSIVE_OPTIONS_REQUESTS_PER_MINUTE=5
MASSIVE_OPTIONS_REQUESTS_PER_MONTH=0
MASSIVE_HISTORY_MAX_YEARS=5
GO_SERVER_A_SHARE_PROVIDER=disabled
GO_SERVER_HK_PROVIDER=disabled
TUSHARE_TOKEN=
TUSHARE_BASE_URL=https://api.tushare.pro
TUSHARE_REQUESTS_PER_MINUTE=200
TUSHARE_HISTORY_MAX_YEARS=5
GO_SERVER_NEWS_PROVIDER=disabled
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com
FMP_NEWS_POLL_INTERVAL=60s
FMP_HISTORY_MAX_YEARS=5
GO_SERVER_NEWS_RETENTION=720h
GO_SERVER_LIVE_PROVIDER=mock
# Set this to a comma-separated list to run several realtime sources together.
GO_SERVER_LIVE_PROVIDERS=
# Optional US intraday tail overlay; requires Massive + Longbridge credentials.
GO_SERVER_US_TAIL_ENABLED=false
GO_SERVER_US_TAIL_WINDOW=30m
GO_SERVER_LONGBRIDGE_HISTORY_ENABLED=false
GO_SERVER_LONGBRIDGE_DEPTH_ENABLED=false
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_HISTORY_MAX_YEARS=5
GO_SERVER_BINANCE_ENABLED=false
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_HISTORY_MAX_YEARS=5
MOCK_HISTORY_MAX_YEARS=5
BINANCE_WS_URL=wss://data-stream.binance.vision
GO_SERVER_CLICKHOUSE_ENABLED=false
GO_SERVER_CLICKHOUSE_RETENTION=43800h
GO_SERVER_CLICKHOUSE_CLEANUP_INTERVAL=720h
GO_SERVER_REDIS_ENABLED=false
GO_SERVER_REDIS_ADDRESS=
GO_SERVER_REDIS_USERNAME=
GO_SERVER_REDIS_PASSWORD=
GO_SERVER_REDIS_DB=0
GO_SERVER_REDIS_TTL=24h
GO_SERVER_MARKET_HISTORY_SYNC_ENABLED=false
GO_SERVER_MARKET_HISTORY_SYNC_INTERVAL=24h
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=market
CLICKHOUSE_USER=market
CLICKHOUSE_PASSWORD=

# go-client
GO_CLIENT_MCP_ENABLED=true
GO_CLIENT_MCP_ALLOW_DOCKER=true
GO_CLIENT_SERVER_URL=https://market.example.com
GO_CLIENT_SERVER_TOKEN=replace-with-the-same-server-token
GO_CLIENT_PARQUET_TTL=720h
GO_CLIENT_CLEANUP_INTERVAL=6h
GO_CLIENT_REDIS_ENABLED=false
# GO_CLIENT_REDIS_ADDRESS=127.0.0.1:6379
# GO_CLIENT_REDIS_USERNAME=
# GO_CLIENT_REDIS_PASSWORD=replace-with-the-redis-password
# GO_CLIENT_REDIS_DB=0
# GO_CLIENT_REDIS_TTL=24h
GO_CLIENT_EMPTY_COVERAGE_TTL=15m
GO_CLIENT_NEWS_RETENTION=720h
GO_CLIENT_CLICKHOUSE_ENABLED=false
# GO_CLIENT_CLICKHOUSE_COMPLETED_BARS_ONLY=true
# GO_CLIENT_CLICKHOUSE_RETENTION=43800h
# GO_CLIENT_CLICKHOUSE_CLEANUP_INTERVAL=720h
GO_CLIENT_STORAGE_CAPABILITY_INTERVAL=5m
# GO_CLIENT_MARKET_HISTORY_SYNC_ENABLED=false
# GO_CLIENT_MARKET_HISTORY_SYNC_INTERVAL=24h
# GO_CLIENT_CLICKHOUSE_URL=http://clickhouse:8123
# CLICKHOUSE_VERSION=25.8-alpine
# CLICKHOUSE_HTTP_PORT=18123
# CLICKHOUSE_MEMORY_LIMIT=2g
# CLICKHOUSE_CPUS=2

# Redis container used by compose.client.yaml
# REDIS_PASSWORD=replace-with-a-long-random-password
# REDIS_MAXMEMORY=1gb
